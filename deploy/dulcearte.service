[Unit]
Description=Gunicorn Dulce Arte - Pasteleria Artesanal
After=network.target postgresql.service

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/dulcearte
EnvironmentFile=/home/ubuntu/dulcearte/.env
ExecStart=/home/ubuntu/dulcearte/venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 2 \
    --timeout 60 \
    --access-logfile /var/log/gunicorn-dulcearte-access.log \
    --error-logfile /var/log/gunicorn-dulcearte-error.log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
